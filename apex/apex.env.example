# Append these lines to docker/.env (Docker) or server/.env.development (bare metal).

# --- Apex module ---
APEX_RAG_PROVIDER=mock                      # mock | anythingllm
APEX_ENTERPRISE_API_URL=http://enterprise-mock:4010   # bare metal: http://localhost:4010
APEX_ENTERPRISE_API_KEY=change-me-to-a-long-random-string
APEX_ENTERPRISE_TIMEOUT_MS=3000
APEX_RAG_TIMEOUT_MS=15000
APEX_MAX_UPLOAD_BYTES=2097152

# Demo only: lets you trigger failures on purpose (question hooks [[AI_ERROR]], [[AI_TIMEOUT]],
# [[NO_CITATIONS]], file hook [[FAIL_PROCESSING]]). The container runs with NODE_ENV=production,
# so BOTH flags are needed. Remove both on any real deployment.
APEX_ENABLE_FAULT_INJECTION=true
APEX_DEMO_MODE=true

# Only when APEX_RAG_PROVIDER=anythingllm (real RAG through AnythingLLM's developer API)
# APEX_ANYTHINGLLM_URL=http://localhost:3001
# APEX_ANYTHINGLLM_API_KEY=
# APEX_ANYTHINGLLM_WORKSPACE=apex
